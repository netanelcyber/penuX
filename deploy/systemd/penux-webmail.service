[Unit]
Description=PenuX Webmail (mail.penux.uk HTTP UI)
Documentation=https://github.com/netanelcyber/penux
After=network.target penux-imap.service
Wants=penux-imap.service

[Service]
Type=simple
User=penux-imap
Group=penux-imap
WorkingDirectory=/opt/penux-imap
ExecStart=/opt/penux-imap/venv/bin/python run_webmail.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=penux-webmail

# Environment — mirrors the IMAP service so webmail connects to local server
EnvironmentFile=-/etc/penux-imap/imap.env
Environment=IMAP_HOST=127.0.0.1
Environment=IMAP_PORT=143
Environment=IMAP_SERVERNAME=mail.penux.uk
Environment=IMAP_TLS_CERT=/etc/ssl/penux/fullchain.pem
Environment=IMAP_TLS_KEY=/etc/ssl/penux/privkey.pem
# Webmail listens on 443 (HTTPS) when TLS cert is present, 80 otherwise
Environment=WEB_HOST=0.0.0.0
Environment=WEB_PORT=443

# Security
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/ssl/penux /etc/penux-imap
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
