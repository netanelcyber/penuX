#!/bin/bash
set -e
# Generate self-signed TLS cert if none exists
CERT_DIR=/etc/kvmweb/ssl
mkdir -p "$CERT_DIR"
if [[ ! -f "$CERT_DIR/cert.pem" ]]; then
  openssl req -x509 -newkey rsa:2048 -keyout "$CERT_DIR/key.pem" \
    -out "$CERT_DIR/cert.pem" -days 3650 -nodes \
    -subj "/CN=kvmweb" 2>/dev/null
  chmod 600 "$CERT_DIR/key.pem"
fi
systemctl daemon-reload
systemctl enable kvmweb.service || true
systemctl restart kvmweb.service || true
