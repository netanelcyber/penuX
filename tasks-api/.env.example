PORT=3000
NODE_ENV=development

# Required for the "Send Now" button (SMTP) and the auto-drafted replies
# inbox watcher (IMAP) — the same App Password works for both.
# See README.md > "Sending Emails" for how to generate an App Password.
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Optional: if set, auto-drafted replies are generated by Claude instead of
# the built-in rule-based templates. See README.md > "Auto-Drafted Replies".
ANTHROPIC_API_KEY=
