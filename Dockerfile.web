FROM node:18-alpine

WORKDIR /app

COPY services/openldap/web/package*.json ./

RUN npm ci --only=production

COPY services/openldap/web/server.js .
COPY services/openldap/web/index.html .
COPY services/openldap/web/enhanced.html .

EXPOSE 3001

ENV NODE_ENV=production
ENV PORT=3001

CMD ["node", "server.js"]
