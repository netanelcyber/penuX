version: 1

# Domain entry
dn: dc=penux,dc=uk
objectClass: dcObject
objectClass: organization
dc: penux
o: PenuX Organization

# Organizations Units
dn: ou=users,dc=penux,dc=uk
objectClass: organizationalUnit
ou: users
description: User accounts

dn: ou=groups,dc=penux,dc=uk
objectClass: organizationalUnit
ou: groups
description: User groups

dn: ou=applications,dc=penux,dc=uk
objectClass: organizationalUnit
ou: applications
description: Application accounts

# Groups
dn: cn=penux-admins,ou=groups,dc=penux,dc=uk
objectClass: groupOfNames
cn: penux-admins
description: PenuX Administrators
member: cn=admin,ou=users,dc=penux,dc=uk

dn: cn=penux-users,ou=groups,dc=penux,dc=uk
objectClass: groupOfNames
cn: penux-users
description: PenuX Standard Users
member: cn=admin,ou=users,dc=penux,dc=uk

dn: cn=penux-developers,ou=groups,dc=penux,dc=uk
objectClass: groupOfNames
cn: penux-developers
description: PenuX Developers
member: cn=admin,ou=users,dc=penux,dc=uk

