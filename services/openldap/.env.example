# OpenLDAP Configuration

# LDAP Admin Password (change this in production!)
LDAP_ADMIN_PASSWORD=admin123

# LDAP Config Password (change this in production!)
LDAP_CONFIG_PASSWORD=config123

# Domain configuration
LDAP_DOMAIN=penux.uk
LDAP_BASE_DN=dc=penux,dc=uk
LDAP_ORGANISATION=PenuX

# TLS/SSL Configuration
LDAP_TLS_ENFORCE=false
LDAP_TLS_VERIFY_CLIENT=never

# Port mapping
LDAP_PORT=389
LDAPS_PORT=636
PHPLDAPADMIN_PORT=80
PHPLDAPADMIN_HTTPS_PORT=6443
