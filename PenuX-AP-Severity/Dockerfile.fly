# Dockerfile for Fly.io deployment of the PenuX-AP-Severity FastAPI service.
# Build context is expected to be PenuX-AP-Severity/ itself (this file's
# directory) — see deploy/flyio/fly.toml, which references this file.
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt pyproject.toml README.md ./
COPY api/ ./api/
COPY src/ ./src/
COPY data/public_sanitized/ap_model_results.csv ./data/public_sanitized/ap_model_results.csv
COPY models/model_sweep_271_results.json ./models/model_sweep_271_results.json

RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 8080
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8080"]
